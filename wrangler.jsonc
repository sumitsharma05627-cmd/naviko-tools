{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naviko",
  "main": "functions/api/[[path]].ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
